VITE_API_URL=/api
VITE_USE_API=true

APP_ENV=production
APP_DEBUG=false
APP_SECRET=generate-a-long-random-secret-at-deploy-time
API_BASE_URL=https://waia.example.com/api
CORS_ORIGINS=https://waia.example.com
SESSION_SECURE_COOKIE=true

DB_HOST=db
DB_PORT=3306
DB_NAME=waia
DB_USER=waia_app
DB_PASSWORD=replace-with-a-long-random-password
DB_ROOT_PASSWORD=replace-with-a-different-long-random-password
